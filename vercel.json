{
  "rewrites": [
    {"source": "/", "destination": "/index.html"},
    {"source": "/index", "destination": "/index.html"},
    {"source": "/grievance", "destination": "/grievances.html"},
    {"source": "/grievances", "destination": "/grievances.html"},
    {"source": "/safety", "destination": "/safety.html"},
    {"source": "/benefits", "destination": "/benefits.html"},
    {"source": "/meetings", "destination": "/meetings.html"},
    {"source": "/qr", "destination": "/qr.html"},
    {"source": "/pdf-viewer", "destination": "/pdf-viewer.html"}
  ],
  "headers": [
    {"source": "/(.*).html", "headers": [{"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]},
    {"source": "/service-worker.js", "headers": [{"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]},
    {"source": "/_shared.(css|js)", "headers": [{"key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400"}]},
    {"source": "/contract.pdf", "headers": [{"key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400"}]},
    {"source": "/icon-(.*).png", "headers": [{"key": "Cache-Control", "value": "public, max-age=604800, immutable"}]}
  ]
}
